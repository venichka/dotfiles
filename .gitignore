# macOS
.DS_Store

# Neovim
.config/nvim/.DS_Store
.config/nvim/lazy-lock.json
.config/nvim/CLAUDE.md
**/.nvimlog

# Alacritty: per-machine overrides and the per-OS symlink sync_to_home.sh makes (see PLATFORMS.md)
.config/alacritty/local.toml
.config/alacritty/os.toml

# nnn: local state you probably don't want
.config/nnn/.lastd
.config/nnn/sessions/
.config/nnn/bookmarks/
.config/nnn/mounts

# General “don’t commit”
**/sockets/
**/*.log
**/*.tmp
